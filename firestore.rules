rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function member(circleId) {
      return signedIn() && circleId is string && circleId.size() > 0 && me().circleId == circleId;
    }
    function parent(circleId) { return member(circleId) && me().role == 'parent'; }
    function sameCircleUser(uid) {
      return member(get(/databases/$(database)/documents/users/$(uid)).data.circleId);
    }
    function validLocation(data) {
      return data.latitude is number && data.latitude >= -90 && data.latitude <= 90
        && data.longitude is number && data.longitude >= -180 && data.longitude <= 180;
    }
    function validProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return (!changed.hasAny(['displayName']) || (data.displayName is string
          && data.displayName.size() > 0 && data.displayName.size() <= 80))
        && (!changed.hasAny(['batteryLevel']) || (data.batteryLevel is int
          && data.batteryLevel >= 0 && data.batteryLevel <= 100))
        && (!changed.hasAny(['isCharging']) || data.isCharging is bool)
        && (!changed.hasAny(['speedMph']) || (data.speedMph is number
          && data.speedMph >= 0 && data.speedMph <= 1000))
        && (!changed.hasAny(['movementActivity']) || data.movementActivity in ['stationary', 'walking', 'driving'])
        && (!changed.hasAny(['lastSeen']) || (data.lastSeen is string && data.lastSeen.size() <= 40));
    }
    match /users/{uid} {
      allow read: if owner(uid) || parent(resource.data.circleId);
      allow create: if owner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'circleId', 'createdAt'])
        && request.resource.data.uid == uid && request.resource.data.role == 'child'
        && request.resource.data.circleId == null && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 80;
      allow update: if owner(uid)
        && validProfileUpdate()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'latitude', 'longitude', 'speedMph', 'movementActivity',
          'batteryLevel', 'isCharging', 'lastSeen'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['latitude', 'longitude'])
          || (member(resource.data.circleId) && validLocation(request.resource.data)));
    }
    match /circles/{circleId} {
      allow read: if member(circleId);
      match /private/{document} { allow read: if parent(circleId); }
    }
    match /locations/{uid} {
      allow read: if owner(uid) || (sameCircleUser(uid) && me().role == 'parent');
      allow create, update: if owner(uid) && member(me().circleId) && validLocation(request.resource.data);
    }
    match /locationHistory/{uid}/points/{pointId} {
      allow read: if owner(uid) || (sameCircleUser(uid) && me().role == 'parent');
      allow create: if owner(uid) && member(me().circleId) && validLocation(request.resource.data)
        && request.resource.data.timestamp is timestamp && request.resource.data.expireAt is timestamp;
    }
    match /places/{placeId} {
      allow read: if member(resource.data.circleId);
      allow create: if parent(request.resource.data.circleId) && request.resource.data.createdBy == request.auth.uid
        && validLocation(request.resource.data) && request.resource.data.radius >= 100 && request.resource.data.radius <= 1000;
      allow update: if parent(resource.data.circleId) && request.resource.data.circleId == resource.data.circleId
        && request.resource.data.createdBy == resource.data.createdBy && validLocation(request.resource.data)
        && request.resource.data.radius >= 100 && request.resource.data.radius <= 1000;
      allow delete: if parent(resource.data.circleId);
    }
    match /sos_alerts/{alertId} {
      allow read: if member(resource.data.circleId);
      // Authenticated callables own sender identity, idempotency and atomic profile state.
    }
    match /placeEvents/{eventId} { allow read: if member(resource.data.circleId); }
    match /sosEvents/{eventId} { allow read: if member(resource.data.circleId); }
    // All membership mutations, invite secrets, rate limits and unspecified paths are backend-only.
  }
}
